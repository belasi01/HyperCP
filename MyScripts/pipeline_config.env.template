# ==============================================================================
# PIPELINE CONFIGURATION PROFILE (PORTABLE ENVIRONMENT VARIABLES)
# ==============================================================================
# Copy this file to pipeline_config.env and fill in your values.
# pipeline_config.env is git-ignored — never commit credentials.

# Execution Mode
RUN_HCP=true
RUN_WebDAV=true
VERBOSE_TERMINAL=true

# WebDAV Server Credentials (Amundsen / ULaval)
WEBDAV_HOST=https://webdisk.data.amundsen.ulaval.ca
WEBDAV_USER=your_user@data.amundsen.ulaval.ca
WEBDAV_PASS=your_password_here

# Campaign Specifications
CRUISE=AMD
EXPERIMENT=CASCADE
# IMU roll bias observed on the Amundsen (degrees, negative = port-side tilt)
ROLL_OFFSET=-5

# Absolute Root Directories (Adjust per platform)
PATH_HCP=/path/to/HyperCP/
MAIN_DATA_PATH=/path/to/data/Amundsen_2026/L1/
LFTP_BIN=/usr/bin/lftp

# Configuration Map References
CFG_FILE_NAME=pySAS_Amundsen_2026_Leg1-3.cfg
HDR_FILE_NAME=pySAS_Amundsen_2026_Leg1-3.hdr

# Target L2 Matrix Versions (Comma-separated, no spaces)
# List the versions to generate when using --level L2 --version ALL
ALL_L2_VERSIONS=M99NN,M99NIR,M99SimSpec,Z17NIR,Z17NN,Z17SimSpec,3CNIR,3CNN,3CSimSpec
