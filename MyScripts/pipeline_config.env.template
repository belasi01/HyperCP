# ==============================================================================
# PIPELINE CONFIGURATION PROFILE (PORTABLE ENVIRONMENT VARIABLES)
# ==============================================================================
# Copy this file to pipeline_config.env and fill in your values.
# pipeline_config.env is git-ignored — never commit credentials.

# Execution Mode
RUN_HCP=true
RUN_WebDAV=true
VERBOSE_TERMINAL=true
# CLOBBER=true forces run_pySAS006_processing.py to overwrite existing outputs
# (needed for a full reprocessing from RAW); false only recomputes missing/failed files.
CLOBBER=true

# Step 1 data source: "webdav" (default, sync from shore over the internet) or "smb"
# (copy from a locally-mounted SMB share -- use while physically on board the Amundsen,
# on the ship's own network; no internet/WebDAV needed in that mode).
SYNC_MODE=webdav

# WebDAV Server Credentials (Amundsen / ULaval) -- only used when SYNC_MODE=webdav
WEBDAV_HOST=https://webdisk.data.amundsen.ulaval.ca
WEBDAV_USER=your_user@data.amundsen.ulaval.ca
WEBDAV_PASS=your_password_here

# Local SMB share (smb://10.0.0.10/data on the Amundsen) -- only used when SYNC_MODE=smb.
# Mount the share first (e.g. Finder "Connect to Server", or `mount_smbfs`), then point
# SMB_MOUNT_POINT at where it lands (macOS default: /Volumes/<sharename>). Subpaths below
# are placeholders -- confirm the real ones once on board, structure may not mirror the
# WebDAV server's TSG_CDOM/ATS/PySAS layout.
SMB_MOUNT_POINT=/Volumes/data
SMB_TSG_SUBPATH=TSG_CDOM
SMB_ATS_SUBPATH=ATS
SMB_PYSAS_SUBPATH=PySAS

# Campaign Specifications
CRUISE=AMD
EXPERIMENT=CASCADE
# IMU roll bias observed on the Amundsen (degrees, negative = port-side tilt)
ROLL_OFFSET=-5
# IMU pitch bias, same mechanism as ROLL_OFFSET (both static offsets applied
# unconditionally to every date -- see README_pipeline.md "IMU roll bias" for why a
# single global value is already known to be wrong for parts of the cruise).
PITCH_OFFSET=0

# Absolute Root Directories (Adjust per platform)
PATH_HCP=/path/to/HyperCP/
MAIN_DATA_PATH=/path/to/data/Amundsen_2026/L1/
LFTP_BIN=/usr/bin/lftp
# Only needed by download_and_run_hypercp.sh (sourced before `conda activate hypercp`,
# since cron runs with no shell rc files loaded). Typically:
#   ~/miniconda3/etc/profile.d/conda.sh   or   ~/anaconda3/etc/profile.d/conda.sh
CONDA_SH_PATH=/path/to/miniconda3/etc/profile.d/conda.sh

# Configuration Map References
CFG_FILE_NAME=pySAS_Amundsen_2026_Leg1-3.cfg
HDR_FILE_NAME=pySAS_Amundsen_2026_Leg1-3.hdr

# Sky-glint correction model(s) to process for L2, used by download_and_run_hypercp.sh:
#   - ALL          : M99 + Z17 + 3C (9 results total: 3 models x NN/NIR/SimSpec)
#   - M99,Z17,3C   : any comma-separated subset (e.g. "M99,Z17" -> 6 results)
#   - M99          : a single model (-> 3 results: M99NN/M99NIR/M99SimSpec)
# For each requested model, the <model>NN version runs through the full L2 pipeline,
# then apply_nir_corrections.py derives the NIR and SimSpec variants (fast, no rerun).
SKY_MODEL=ALL
