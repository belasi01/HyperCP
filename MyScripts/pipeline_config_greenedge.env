# ==============================================================================
# GreenEdge 2016 HyperSAS PIPELINE CONFIGURATION
# ==============================================================================
# Separate from pipeline_config.env (pySAS/Amundsen 2026 -- unrelated project,
# different instrument/folder layout). Used by run_greenedge_processing.py and
# apply_nir_corrections_greenedge.py.

PATH_HCP=/Users/simonbelanger/PythonProjects/HyperCP/

# Root under which each station lives as <GREENEDGE_ROOT>/<date>_Station<name>/HyperSAS/
# (single .raw file per station -- not the continuous multi-file pySAS layout).
# Stations are added here progressively as they're prepared; the scripts just
# discover whatever's present, no fixed list to maintain.
GREENEDGE_ROOT=/Users/simonbelanger/Data/GreenEdge/L2

# General config (NOT per-station: per-station .cfg files exist but default to
# bL1bGetAnc=1, which calls out to GMAO/oceandata.sci.gsfc.nasa.gov for AOD/wind
# gap-filling and times out without a reachable network -- GreenEdge2016.cfg has
# bL1bGetAnc=0). Same CalibrationFiles list as every per-station .cfg (same
# instrument for the whole campaign), and Config/GreenEdge2016_Calibration/ (the
# folder matching this basename) is the one actually populated with real .cal
# files -- the per-station *_Calibration/ folders were all found empty.
CFG_FILE_NAME=GreenEdge2016.cfg

CLOBBER=true
