#
# Frame header (SATTHS1500 - IMU)
#
VLF_INSTRUMENT UMTWR '' 9 AS 0 NONE

#
# Fields
#
FIELD NONE ',' 1 AS 0 DELIMITER
HEADING_SAS NONE 'deg' V AF 0 COUNT

FIELD NONE ',' 1 AS 0 DELIMITER
HEADING_SHIP NONE 'deg' V AF 0 COUNT

FIELD NONE ',' 1 AS 0 DELIMITER
HEADING_ACCURACY_SHIP NONE 'deg' V AF 0 COUNT

FIELD NONE ',' 1 AS 0 DELIMITER
HEADING_MOTION NONE 'deg' V AF 0 COUNT

FIELD NONE ',' 1 AS 0 DELIMITER
HEADING_ACCURACY_MOTION NONE 'deg' V AF 0 COUNT

FIELD NONE ',' 1 AS 0 DELIMITER
POSITION_TOWER NONE 'deg' V AF 0 COUNT

FIELD NONE ',' 1 AS 0 DELIMITER
STATUS_TOWER NONE '' V AS 0 COUNT  # 'AS' = ASCII string field (adjust if your parser differs)

FIELD NONE ',' 1 AS 0 DELIMITER
AZIMUTH_SUN NONE 'deg' V AF 0 COUNT

FIELD NONE ',' 1 AS 0 DELIMITER
ELEVATION_SUN NONE 'deg' V AF 0 COUNT

#
# AOSI checksum and carriage return and line feed - do not display
#
FIELD NONE '\x2A' 1 AS 0 DELIMITER
EXTRA NONE '' V AS 0 NONE 

TERMINATOR NONE '\x0D\x0A' 2 AS 0 DELIMITER

#
# end of AOSI data
#
